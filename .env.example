# Copy this file to .env, then fill in every empty value (ENG-01 7.1).
# .env holds real passwords and Git ignores it. Never commit it.
# Use letters, digits, - and _ only: Docker Compose reads $ as a variable.
#
# The four secrets are left empty on purpose: Docker Compose won't start
# until each one is set. Make each one fresh with the command above it, in
# Git Bash, and paste what it prints after the =. Each example shows the
# form only. Never use an example, and never give two settings one value.
#
# Set the three passwords before the first docker compose up -d. The db
# container sets them on its first start only, so a password changed in
# .env afterwards no longer matches the database's.

# Signs sessions and CSRF tokens. At least 50 random characters.
#   Make one:      openssl rand -hex 32
#   For example:   80ad13c2abb1a0d3d887dab25d6d7b560f2c396b5dd9d273108ad9d48f0220ea
SECRET_KEY=
# The database superuser's password, used only inside the db container.
#   Make one:      openssl rand -hex 16
#   For example:   aac73d560c6e81457f91376c46263607
POSTGRES_PASSWORD=
DB_NAME=ids_audit
DB_HOST=127.0.0.1
DB_PORT=5432
# The password of ids_owner, which owns the tables. Migrations sign in with it.
#   Make one:      openssl rand -hex 16
#   For example:   1559be00d0855a93c03b30382c8ae940
DB_OWNER_PASSWORD=
# The password of ids_app, which the application signs in with.
#   Make one:      openssl rand -hex 16
#   For example:   a09acd83c73f6f637929a7280b62e08f
DB_APP_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1
APP_PORT=8000
MAX_UPLOAD_MB=50
SESSION_IDLE_MINUTES=30
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=300
TIME_ZONE=Asia/Muscat
DEBUG=False

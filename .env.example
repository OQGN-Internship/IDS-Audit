# Copy this file to .env, then fill in every empty value (ENG-01 7.1).
# .env holds real passwords and Git ignores it. Never commit it.
# Use letters, digits, - and _ only: Docker Compose reads $ as a variable.

SECRET_KEY=
POSTGRES_PASSWORD=
DB_NAME=ids_audit
DB_HOST=127.0.0.1
DB_PORT=5432
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1
APP_PORT=8000
MAX_UPLOAD_MB=50
SESSION_IDLE_MINUTES=30
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
GUNICORN_WORKERS=3
TIME_ZONE=Asia/Muscat
DEBUG=False
